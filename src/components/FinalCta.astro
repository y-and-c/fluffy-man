---
// Final CTA — handoff README §"Homepage — Final CTA + Footer"
// Sits directly above the Footer; same charcoal background so the two
// flow together while the Footer's top hairline acts as the divider.
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <div class="final-cta__inner">
    <h2 id="final-cta-title" class="h2">Ready to build something that converts?</h2>
    <p class="final-cta__lead">
      Book a free call — we’ll reply within one business day.
    </p>
    <a class="btn btn--manilla" href="/contact">Get in touch</a>
  </div>
</section>

<style>
  .final-cta {
    background: var(--color-charcoal);
    color: #fff;
    padding: clamp(64px, 10vw, 104px) var(--pad-x) clamp(56px, 8vw, 88px);
  }

  .final-cta__inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-h2-cta);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: #fff;
    margin: 0 0 20px;
    text-wrap: balance;
  }

  .final-cta__lead {
    font-size: clamp(17px, 2.2vw, 18px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
    margin: 0 0 36px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 600;
    padding: 15px 30px;
    border-radius: var(--radius-button);
    text-decoration: none;
    transition: background var(--tx-fast);
  }

  .btn--manilla {
    background: var(--color-manilla);
    color: var(--color-charcoal);
  }

  .btn--manilla:hover {
    background: var(--color-manilla-hover);
  }
</style>
