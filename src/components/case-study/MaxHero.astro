---
// Case study — hero. Y&C page chrome (System A) wrapping the maxproperty.au
// home mock (System B). The mock's design tokens are Max Property's own —
// kept inline so they don't leak into the agency's design system.
---

<header class="mx-hero">
  <div class="mx-hero__texture" aria-hidden="true"></div>
  <div class="mx-hero__inner">
    <div class="mx-hero__copy" data-reveal>
      <p class="mx-hero__eyebrow">Case study · Real estate</p>
      <h1 class="mx-hero__h1">
        Max Property — a boutique agency, <em>built</em> to feel like the market
        leader.
      </h1>
      <p class="mx-hero__sub">
        Boutique estate agents on the Sunshine Coast needed a site that signals
        premium credibility, converts both vendors and buyers, and lets them
        publish market insights without touching code.
      </p>
    </div>

    <div class="mx-hero__meta" data-reveal>
      <span>Sunshine Coast, QLD</span>
      <span class="mx-hero__dot" aria-hidden="true">·</span>
      <span>Agency website</span>
      <span class="mx-hero__dot" aria-hidden="true">·</span>
      <span>Year 2026</span>
      <span class="mx-hero__dot" aria-hidden="true">·</span>
      <a
        href="https://maxproperty.au"
        target="_blank"
        rel="noopener"
        class="mx-hero__link">maxproperty.au ↗</a
      >
    </div>

    <figure class="mx-hero__figure" data-reveal>
      <div class="mock mock--hero">
        <div class="mock__chrome">
          <span class="mock__dot"></span>
          <span class="mock__dot"></span>
          <span class="mock__dot"></span>
          <span class="mock__url mono">maxproperty.au</span>
        </div>

        <div class="mock-hero">
          <div class="mock-hero__nav">
            <svg
              viewBox="95 735 1350 525"
              class="mock-hero__wordmark"
              fill="#F4EDE5"
              aria-label="Max."
              role="img"
            >
              <path
                d="M1331.77 853.609L1200.23 1018.44L1339.16 1238.7V1242.39H1144.81V1237.96L1179.54 1207.65L1101.21 1081.26C1076.83 1118.22 1065.01 1202.48 1128.56 1236.48V1242.39H956.381V1237.96L1096.04 1072.39L960.076 853.609V849.174H1150.72V853.609L1115.99 883.913L1195.06 1009.57C1213.54 972.609 1226.1 886.87 1167.72 854.348V849.174H1331.77V853.609Z"
              ></path>
              <path
                d="M953.344 1158.13L1008.03 1130.04L1010.98 1133.74C965.906 1197.3 934.87 1251.26 889.055 1251.26C854.325 1251.26 826.984 1229.83 832.895 1147.78H829.2C804.815 1202.48 769.346 1252 703.579 1252C653.33 1252 618.6 1222.44 618.6 1172.91C618.6 1103.44 685.105 1065.74 747.177 1036.91L828.461 1001.44C829.2 926.044 805.554 878.74 770.084 880.957C739.788 883.914 723.531 914.957 750.133 1000.7L613.427 1039.13L611.21 1035.44C698.406 846.218 838.807 838.088 850.63 838.088C968.123 838.088 966.645 914.957 959.995 1016.22L953.344 1147.04V1158.13ZM775.996 1162.57C790.775 1162.57 812.205 1151.48 826.984 1122.65L828.461 1017.7C767.129 1059.83 743.482 1090.13 743.482 1121.91C743.482 1152.22 762.695 1162.57 775.996 1162.57Z"
              ></path>
              <path
                d="M620.938 743.478V747.913L592.858 786.348L593.597 1242.39H409.598V1237.96L449.502 1199.52L448.763 850.652H444.329L320.925 1154.43H312.796L167.223 857.304H163.528V906.826C163.528 1065.74 211.56 1164.04 303.19 1238.7V1242.39H147.271V821.826L105.89 747.913V743.478L265.503 742L372.651 968.174H376.346L466.498 743.478H620.938Z"
              ></path>
              <rect
                x="1361.68"
                y="1172.9"
                width="73.2076"
                height="73.2255"
                rx="7.07152"
                fill="#9D4D2A"></rect>
            </svg>
            <div class="mock-hero__navlinks">
              <span>Sell</span>
              <span>Buy</span>
              <span>Locations</span>
              <span>Insights</span>
              <span>Team</span>
              <span>Contact</span>
            </div>
            <span class="mock-hero__navcta">Request an Appraisal</span>
          </div>

          <div class="mock-hero__content">
            <div class="mock-hero__overline mono">
              Estate Agents · Sunshine Coast
            </div>
            <div class="mock-hero__h1">
              Your outcome <em>drives</em> our approach.
            </div>
            <p class="mock-hero__sub">
              Personalised service and trusted expertise. Our team handles every
              detail — so you can sell or buy with confidence and ease.
            </p>
            <div class="mock-hero__ctas">
              <span class="mock-btn mock-btn--ember">
                Request an appraisal <span aria-hidden="true">→</span>
              </span>
              <span class="mock-btn mock-btn--ghost">Browse properties</span>
            </div>
          </div>
        </div>

        <div class="mock-proofbar">
          <div class="mock-proofbar__cell">
            <div class="mock-proofbar__n">20+</div>
            <div class="mock-proofbar__label">Years combined experience</div>
          </div>
          <div class="mock-proofbar__cell">
            <div class="mock-proofbar__n">500+</div>
            <div class="mock-proofbar__label">Properties sold</div>
          </div>
          <div class="mock-proofbar__cell">
            <div class="mock-proofbar__n">4.9</div>
            <div class="mock-proofbar__label">Average vendor rating</div>
            <div class="mock-proofbar__meta">from 180+ reviews</div>
          </div>
          <div class="mock-proofbar__cell mock-proofbar__cell--last">
            <div class="mock-proofbar__n">100%</div>
            <div class="mock-proofbar__label">Data-led, human-centred</div>
          </div>
        </div>
      </div>
      <figcaption class="mx-hero__caption">
        Mock — maxproperty.au home
      </figcaption>
    </figure>
  </div>
</header>

<style>
  .mx-hero {
    position: relative;
    background: var(--color-manilla);
    padding: clamp(48px, 8vw, 96px) clamp(20px, 5vw, 72px)
      clamp(40px, 6vw, 72px);
    overflow: hidden;
  }

  .mx-hero__texture {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      rgba(43, 42, 53, 0.07) 1px,
      transparent 1px
    );
    background-size: 26px 26px;
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent,
      #000 26%,
      #000 74%,
      transparent
    );
    mask-image: linear-gradient(
      180deg,
      transparent,
      #000 26%,
      #000 74%,
      transparent
    );
    opacity: 0.5;
    pointer-events: none;
  }

  .mx-hero__inner {
    position: relative;
    max-width: 1140px;
    margin: 0 auto;
  }

  .mx-hero__copy {
    max-width: 840px;
  }

  .mx-hero__eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-charcoal-hover);
    margin: 0 0 24px;
  }

  .mx-hero__h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 6vw, 62px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--color-charcoal);
    margin: 0 0 26px;
    text-wrap: balance;
  }

  .mx-hero__h1 em {
    font-style: italic;
    font-weight: 500;
  }

  .mx-hero__sub {
    font-size: clamp(17px, 2.2vw, 20px);
    line-height: 1.55;
    color: var(--color-charcoal-hover);
    max-width: 660px;
    margin: 0;
  }

  .mx-hero__meta {
    margin: clamp(26px, 4vw, 38px) 0 clamp(28px, 4vw, 44px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    font-size: 13px;
    color: var(--color-charcoal-hover);
  }

  .mx-hero__dot {
    color: var(--color-charcoal);
  }

  .mx-hero__link {
    color: var(--color-charcoal);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid rgba(43, 42, 53, 0.4);
    padding-bottom: 1px;
  }

  .mx-hero__figure {
    margin: 0;
  }

  .mx-hero__caption {
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: #9a958a;
    margin-top: 12px;
  }

  /* Browser-frame mock — Y&C-side chrome */
  .mock {
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
  }

  .mock--hero {
    box-shadow: 0 24px 60px -28px rgba(43, 42, 53, 0.4);
  }

  .mock__chrome {
    height: 36px;
    background: var(--color-surface-alt);
    border-bottom: 1px solid #e6e9ee;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 14px;
  }

  .mock__dot {
    width: 9px;
    height: 9px;
    border-radius: 100px;
    background: #d2d7dd;
  }

  .mock__url {
    margin-left: 10px;
    background: #fff;
    border: 1px solid #e6e9ee;
    border-radius: 100px;
    font-size: 10.5px;
    color: #9aa0a6;
    padding: 3px 12px;
  }

  .mono {
    font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  /* Mock content — Max Property design system (System B) */
  .mock-hero {
    position: relative;
    background: linear-gradient(168deg, #4a4334 0%, #2a2018 48%, #1a120c 100%);
    padding: clamp(15px, 1.8vw, 20px) clamp(18px, 2.6vw, 34px)
      clamp(28px, 4.5vw, 52px);
  }

  .mock-hero__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .mock-hero__wordmark {
    height: 17px;
    width: auto;
    display: block;
    flex: none;
  }

  .mock-hero__navlinks {
    display: flex;
    align-items: center;
    gap: clamp(11px, 1.5vw, 20px);
  }

  .mock-hero__navlinks span {
    font-size: 11.5px;
    color: rgba(244, 237, 229, 0.85);
  }

  @media (max-width: 720px) {
    .mock-hero__navlinks {
      display: none;
    }
  }

  .mock-hero__navcta {
    flex: none;
    font-size: 10.5px;
    color: #fff;
    background: #9d4d2a;
    border-radius: 6px;
    padding: 6px 12px;
  }

  .mock-hero__content {
    padding-top: clamp(38px, 8vw, 92px);
    max-width: 560px;
  }

  .mock-hero__overline {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(244, 237, 229, 0.7);
    margin-bottom: clamp(16px, 2.4vw, 26px);
  }

  .mock-hero__h1 {
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
    font-size: clamp(34px, 6.4vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: #f4ede5;
  }

  .mock-hero__h1 em {
    font-style: italic;
    color: #fcc873;
  }

  .mock-hero__sub {
    margin: clamp(16px, 2.4vw, 24px) 0 0;
    font-family: "Geist", system-ui, sans-serif;
    font-size: clamp(12px, 1.5vw, 15px);
    line-height: 1.5;
    color: rgba(244, 237, 229, 0.85);
    max-width: 360px;
  }

  .mock-hero__ctas {
    margin-top: clamp(18px, 2.6vw, 30px);
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .mock-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: "Geist", sans-serif;
    font-size: 12px;
    font-weight: 500;
    border-radius: 8px;
    padding: 10px 16px;
  }

  .mock-btn--ember {
    color: #fff;
    background: #9d4d2a;
  }

  .mock-btn--ghost {
    color: #f4ede5;
    border: 1px solid rgba(244, 237, 229, 0.3);
  }

  /* Proof bar */
  .mock-proofbar {
    background: #fff;
    border-top: 1px solid #e2ddd4;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  @media (max-width: 560px) {
    .mock-proofbar {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .mock-proofbar__cell {
    padding: clamp(18px, 2.4vw, 26px) clamp(16px, 2vw, 24px);
    border-right: 1px solid #ece7de;
  }

  .mock-proofbar__cell--last {
    border-right: 0;
  }

  @media (max-width: 560px) {
    .mock-proofbar__cell:nth-child(2n) {
      border-right: 0;
    }
    .mock-proofbar__cell:nth-child(-n + 2) {
      border-bottom: 1px solid #ece7de;
    }
  }

  .mock-proofbar__n {
    font-family: "Instrument Serif", Georgia, serif;
    font-size: clamp(28px, 4vw, 50px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #1a120c;
  }

  .mock-proofbar__label {
    margin-top: 8px;
    font-family: "Geist", sans-serif;
    font-size: 11.5px;
    line-height: 1.35;
    color: #2c1e15;
  }

  .mock-proofbar__meta {
    font-family: "Geist", sans-serif;
    font-size: 10.5px;
    color: #756e69;
    margin-top: 2px;
  }
</style>
