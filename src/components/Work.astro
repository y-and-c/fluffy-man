---
// Selected work — links to the case studies. Hero "See our work" anchors here.
const work = [
  {
    href: "/work/max-property",
    tag: "Real estate agency",
    title: "Max Property",
    body: "A boutique Sunshine Coast agency's website: premium credibility, vendor and buyer conversion, and market insights the team publishes without touching code.",
  },
  {
    href: "/work/treble-property-group",
    tag: "Property development",
    title: "Treble Property Group",
    body: "A new Queensland developer with no brand identity: a fast, credible site with live projects and lots, wired into Claude and GoHighLevel.",
  },
];
---

<section id="work" class="work">
  <div class="work__inner">
    <div class="work__head">
      <p class="eyebrow">Our work</p>
      <h2 class="h2">Sites that carry the business</h2>
    </div>

    <div class="work__grid">
      {
        work.map((w) => (
          <a class="work-card" href={w.href}>
            <span class="work-card__tag">{w.tag}</span>
            <h3 class="work-card__title">{w.title}</h3>
            <p class="work-card__body">{w.body}</p>
            <span class="work-card__link">
              Read the case study <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    background: var(--color-surface);
    padding: var(--pad-section) var(--pad-x);
    scroll-margin-top: 64px;
  }

  .work__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .work__head {
    max-width: var(--prose-max);
    margin: 0 0 48px;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-charcoal-hover);
    margin: 0 0 16px;
  }

  .h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-h2);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-charcoal);
    margin: 0;
    text-wrap: balance;
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .work-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 32px;
    text-decoration: none;
    transition:
      box-shadow var(--tx-slow),
      transform var(--tx-slow),
      border-color var(--tx-slow);
  }

  .work-card:hover,
  .work-card:focus-visible {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
    border-color: var(--color-manilla);
  }

  .work-card__tag {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-charcoal-hover);
    margin-bottom: 14px;
  }

  .work-card__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-h3);
    line-height: 1.25;
    color: var(--color-charcoal);
    margin: 0 0 12px;
  }

  .work-card__body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-charcoal-hover);
    margin: 0 0 24px;
  }

  .work-card__link {
    margin-top: auto;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-link);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .work-card:hover .work-card__link {
    text-decoration: underline;
  }
</style>
