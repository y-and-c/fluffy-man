---
// Homepage hero — handoff README §"Homepage — Hero"
---

<header id="top" class="hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="hero__inner">
    <p class="eyebrow">Websites for property</p>
    <h1 class="display-h1">Websites that work as hard as you do in property</h1>
    <p class="lead">
      We build fast, conversion-ready websites for real estate agents, developers,
      and construction businesses &mdash; built to win trust and generate leads.
    </p>
    <div class="hero__ctas">
      <a class="btn btn--dark" href="/contact">Book a free call</a>
      <a class="btn btn--ghost-light" href="#services">See our work</a>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    background: var(--color-manilla);
    padding: clamp(72px, 11vw, 128px) var(--pad-x) clamp(56px, 8vw, 96px);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(43, 42, 53, 0.07) 1px, transparent 1px);
    background-size: 26px 26px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
    opacity: 0.5;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-charcoal-hover);
    margin: 0 0 24px;
  }

  .display-h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-h1-home);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--color-charcoal);
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .lead {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-charcoal-hover);
    max-width: 620px;
    margin: 0 auto 40px;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 600;
    padding: 14px 26px;
    border-radius: var(--radius-button);
    text-decoration: none;
    transition:
      background var(--tx-fast),
      color var(--tx-fast),
      border-color var(--tx-fast);
  }

  .btn--dark {
    background: var(--color-charcoal);
    color: #fff;
    box-shadow: var(--shadow-button);
  }

  .btn--dark:hover {
    background: var(--color-charcoal-hover);
  }

  .btn--ghost-light {
    background: transparent;
    color: var(--color-charcoal);
    border: 1.5px solid var(--color-charcoal);
    padding: 12.5px 26px;
  }

  .btn--ghost-light:hover {
    background: var(--color-charcoal);
    color: #fff;
  }
</style>
