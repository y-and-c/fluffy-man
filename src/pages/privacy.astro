---
import Site from "../layouts/Site.astro";

const updated = "12 June 2026";
---

<Site
  title="Privacy — Y&C"
  description="How Y&C collects, uses, and protects the information you share through our enquiry form."
  navVariant="contact"
>
  <main class="privacy">
    <article class="privacy__inner">
      <p class="eyebrow">Privacy</p>
      <h1 class="display-h1">Privacy policy</h1>
      <p class="updated">Last updated: {updated}</p>

      <section>
        <h2>Who we are</h2>
        <p>
          Y&amp;C is a web-design studio working with Australian property
          businesses. If you have any questions about this policy or the data
          we hold, email <a href="mailto:hello@yandc.com.au">hello@yandc.com.au</a>.
        </p>
      </section>

      <section>
        <h2>What we collect</h2>
        <p>
          We collect the information you choose to send us through the enquiry
          form on this site:
        </p>
        <ul>
          <li>Your name</li>
          <li>Your email address</li>
          <li>Your company (optional)</li>
          <li>What you’re looking for (optional)</li>
          <li>The message you write</li>
        </ul>
        <p>
          We don’t use third-party analytics, advertising trackers, or cookies
          to identify you across other sites.
        </p>
      </section>

      <section>
        <h2>How we use it</h2>
        <p>
          We use the information you send only to reply to your enquiry and to
          talk about a potential project. We don’t sell, rent, or share your
          details with anyone else.
        </p>
      </section>

      <section>
        <h2>Where it’s stored</h2>
        <p>
          Enquiries are delivered to our inbox via <a
            href="https://resend.com"
            rel="noopener noreferrer"
            target="_blank">Resend</a
          >, our email provider. The site itself is hosted on
          <a href="https://vercel.com" rel="noopener noreferrer" target="_blank">Vercel</a>.
          Both providers process data in line with their own privacy policies.
        </p>
      </section>

      <section>
        <h2>How long we keep it</h2>
        <p>
          We keep enquiry emails for as long as we’re in active conversation,
          and for a reasonable period afterwards to refer back to. You can ask
          us to delete your data at any time.
        </p>
      </section>

      <section>
        <h2>Your rights</h2>
        <p>
          Under Australian privacy law, you can ask to see what data we hold
          about you, ask us to correct it, or ask us to delete it. Email
          <a href="mailto:hello@yandc.com.au">hello@yandc.com.au</a> and we’ll
          action it within a reasonable timeframe.
        </p>
      </section>

      <section>
        <h2>Changes to this policy</h2>
        <p>
          If we update this policy we’ll change the date at the top of the page.
          For material changes we’ll do our best to make it obvious.
        </p>
      </section>
    </article>
  </main>
</Site>

<style>
  .privacy {
    background: var(--color-surface);
    padding: clamp(56px, 8vw, 96px) var(--pad-x) clamp(64px, 9vw, 104px);
  }

  .privacy__inner {
    max-width: var(--prose-max);
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-charcoal-hover);
    margin: 0 0 20px;
  }

  .display-h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-h1-contact);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-charcoal);
    margin: 0 0 12px;
    text-wrap: balance;
  }

  .updated {
    font-size: 14px;
    color: var(--color-muted);
    margin: 0 0 40px;
  }

  section {
    margin-bottom: 32px;
  }

  section:last-child {
    margin-bottom: 0;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.3;
    color: var(--color-charcoal);
    margin: 0 0 12px;
  }

  p,
  li {
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-charcoal-hover);
  }

  p {
    margin: 0 0 12px;
  }

  ul {
    margin: 0 0 12px;
    padding-left: 22px;
  }

  li {
    margin: 0 0 4px;
  }

  a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }
</style>
