---
import Site from "../layouts/Site.astro";
---

<Site
  title="Y&C — Websites for property"
  description="Y&C builds fast, conversion-ready websites for Australian real estate agencies, property managers, developers, and construction firms."
  navVariant="home"
>
  <main id="top">
    {/* Hero — handoff README §"Homepage — Hero" */}
    <section class="hero">
      <div class="hero__bg" aria-hidden="true"></div>
      <div class="hero__inner">
        <p class="eyebrow">Websites for property</p>
        <h1 class="display-h1">Websites that work as hard as you do in property</h1>
        <p class="lead">
          We build fast, conversion-ready websites for real estate agents, developers,
          and construction businesses — built to win trust and generate leads.
        </p>
        <p style="margin-top:2rem;color:var(--color-charcoal-hover)">
          <em>Foundation scaffold — section components land in the next pass.</em>
        </p>
      </div>
    </section>

    {/*
      Sections to build in follow-up pass (see _handoff README):
        - <Services id="services" />     // 3-card grid on #F2F4F7
        - <WhyYC    id="why" />          // charcoal section, stat grid
        - <Faqs     id="faqs" />         // manilla section, single-open accordion
        - <FinalCta />                   // charcoal CTA before footer
    */}
  </main>
</Site>

<style>
  .hero {
    position: relative;
    background: var(--color-manilla);
    padding: clamp(72px, 11vw, 128px) var(--pad-x) clamp(56px, 8vw, 96px);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(43, 42, 53, 0.07) 1px, transparent 1px);
    background-size: 26px 26px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
    opacity: 0.5;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-charcoal-hover);
    margin: 0 0 24px;
  }

  .display-h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-h1-home);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--color-charcoal);
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .lead {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-charcoal-hover);
    max-width: 620px;
    margin: 0 auto;
  }
</style>
