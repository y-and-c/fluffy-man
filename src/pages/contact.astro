---
import Site from "../layouts/Site.astro";
import ContactIntro from "../components/ContactIntro.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
---

<Site
  title="Contact — Y&C"
  description="Get in touch with Y&C. We reply within one business day to enquiries from Australian property businesses."
  navVariant="contact"
>
  <main class="contact">
    <div class="contact__inner">
      <ContactIntro />
      <EnquiryForm />
    </div>
  </main>
</Site>

<style>
  .contact {
    background: var(--color-manilla);
    padding: clamp(56px, 8vw, 96px) var(--pad-x) clamp(64px, 9vw, 104px);
    min-height: calc(100vh - 64px);
  }

  .contact__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(40px, 7vw, 80px);
    align-items: start;
  }
</style>
